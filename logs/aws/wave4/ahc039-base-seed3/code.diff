-    ray start --head --num-cpus="${TOTAL_CPUS}" --disable-usage-stats >/dev/null
+  if ! "$RAY_BIN" status >/dev/null 2>&1; then
+    echo "No Ray head found — starting one (--num-cpus ${TOTAL_CPUS}, temp-dir ${RAY_TEMP_DIR})."
