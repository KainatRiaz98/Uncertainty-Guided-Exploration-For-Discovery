+# ── Per-case scratch: keep it local (fast) AND bounded (no disk overflow) ────
+#
+# Each evaluated case gets its own scratch dir for input/output. Two independent
+# problems had to be solved here:
+#
+#   1. LEAK. These dirs were never removed. ~128KB per case x ~57,600 cases in a
+#      6-epoch ahc039 run is ~7.4GB, which overran the 29GB root volume, killed a
+#      wave mid-run and truncated a LoRA checkpoint. Relocating them alone only
+#      moves the leak to a roomier disk -- it still grows without bound.
+#   2. SPEED. The dirs must stay on a fast node-local filesystem. Relocating them
+#      costs nothing here (/tmp and the nvme volume are both ext4 on this host);
+#      the 15x slowdown seen when swapping this file wholesale came from losing
+#      the parallel per-case Ray executor, not from the path.
+#
+# So: place them on a large local volume, and delete each one as soon as its case
+# finishes. Steady-state usage is bounded by concurrency (~24 dirs), not by the
+# total number of cases evaluated.
+_SCRATCH_FALLBACK_VOLUMES = ("/opt/dlami/nvme",)
+
+# Dirs created while serving the CURRENT case, cleaned up when it completes.
+# A Ray worker process runs one case at a time, so a module-level list is safe
+# and -- unlike globbing by prefix -- cannot delete a concurrent run's scratch.
+_ACTIVE_CASE_SCRATCH: list = []
+
+
+def get_local_scratch_root() -> str:
+    """Root for per-case scratch dirs, local to the node to avoid NFS latency.
+
+    Overridable via ALE_BENCH_LOCAL_TMPDIR, then TMPDIR. Note these are often
+    ABSENT here: evaluation runs in Ray workers forked from the raylet, so they
+    inherit the raylet's environment, not the training driver's. Exporting the
+    vars before a launch does not reach this code unless the Ray head was started
+    from that same environment -- hence the fallback matters more than the
+    overrides.
+    """
+    root = os.environ.get("ALE_BENCH_LOCAL_TMPDIR") or os.environ.get("TMPDIR")
+    if not root:
+        for vol in _SCRATCH_FALLBACK_VOLUMES:
+            if os.path.isdir(vol):
+                root = os.path.join(vol, "scratch", "ale_bench")
+                break
+        else:
+            root = "/tmp"
+    os.makedirs(root, exist_ok=True)
+    return root
+
+
+def make_case_scratch_dir(problem_id: str, case_idx: int) -> Path:
+    """Create a per-case scratch dir and register it for cleanup."""
+    d = Path(tempfile.mkdtemp(
+        prefix=f"ale_bench_local_{problem_id}_{case_idx}_", dir=get_local_scratch_root()
+    ))
+    _ACTIVE_CASE_SCRATCH.append(d)
+    return d
+
+
+def cleanup_case_scratch() -> None:
+    """Remove scratch dirs registered for the case that just finished."""
+    while _ACTIVE_CASE_SCRATCH:
+        d = _ACTIVE_CASE_SCRATCH.pop()
+        shutil.rmtree(d, ignore_errors=True)
+
+
